# Variáveis do site institucional (Vercel). Todas públicas; nunca coloque segredos aqui.

# URL pública do site (ex.: https://perfin.vercel.app)
NEXT_PUBLIC_SITE_URL=
# URL pública do Portal (ex.: https://portal-perfin.vercel.app)
