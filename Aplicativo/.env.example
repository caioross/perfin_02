# Variáveis do Portal Perfin (Vercel). Copie os nomes para a Vercel; nunca versione valores.

# URL pública do Portal na Vercel (ex.: https://portal-perfin.vercel.app)
NEXT_PUBLIC_SITE_URL=

# Supabase (públicas: URL e publishable key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key (sb_secret_...) — só servidor; usada apenas para a tabela google_tokens
SUPABASE_SECRET_KEY=

# OAuth Google (o mesmo client cadastrado no provedor Google do Supabase)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# 32 bytes em base64 para cifrar o refresh token do Google
# (gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
TOKEN_ENCRYPTION_KEY=
